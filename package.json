{
  "name": "webhand",
  "version": "0.8.0",
  "description": "Delegate everyday browser work to your coding agent — safely, verifiably, and with saved runbooks.",
  "license": "MIT",
  "author": "sakamoto66",
  "homepage": "https://github.com/sakamoto66/webhand",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakamoto66/webhand.git"
  },
  "keywords": [
    "browser",
    "agent",
    "automation",
    "runbook",
    "agent-skills",
    "claude-code",
    "antigravity",
    "codex"
  ],
  "type": "module",
  "bin": {
    "webhand": "dist/bin.js"
  },
  "files": [
    "dist",
    "assets",
    "LICENSE",
    "THIRD_PARTY_LICENSE_jev-ultrafast.txt",
    "README.md",
    "README.ja.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "check": "npm run lint && npm run typecheck && npm run knip",
    "check:package": "node scripts/check-package.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:coverage": "vitest run --coverage",
    "test:golden:update": "UPDATE_GOLDEN=1 vitest run tests/golden.test.ts",
    "version": "node scripts/sync-version.ts",
    "smoke": "node research/smoke.ts",
    "verify:tasks": "node research/smoke.ts --all",
    "prepare": "husky",
    "prepublishOnly": "npm run check && npm run build && npm run check:package"
  },
  "dependencies": {
    "playwright-core": "~1.65.0",
    "smol-toml": "^1.9.1",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
