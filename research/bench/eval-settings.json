{
  "permissions": {
    "deny": ["Bash(rtk bulk-read:*)", "Bash(rtk code-write:*)"]
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@CODE@/scripts/beep.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "@CODE@/scripts/auto_answer.py"
          }
        ]
      }
    ]
  }
}
